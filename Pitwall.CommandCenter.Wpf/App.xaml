<Application x:Class="Pitwall.CommandCenter.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D4EDFF" />
      </Style>
      <Style TargetType="Window">
        <Setter Property="Background" Value="#040506" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="#0C1A23" />
        <Setter Property="Foreground" Value="#D4EDFF" />
        <Setter Property="BorderBrush" Value="#2A4B5E" />
        <Setter Property="Padding" Value="10,4" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0B141A" />
        <Setter Property="Foreground" Value="#D4EDFF" />
        <Setter Property="BorderBrush" Value="#2A4B5E" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
