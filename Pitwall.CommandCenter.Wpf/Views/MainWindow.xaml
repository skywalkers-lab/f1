<Window x:Class="Pitwall.CommandCenter.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="http://schemas.livecharts.com/2.0/wpf"
        Title="Pitwall Command Center" Height="980" Width="1580"
        MinHeight="820" MinWidth="1280">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="#244A5E" BorderThickness="1" Background="#091017" Padding="10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="UDP Host" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Text="{Binding UdpHost, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Port" Margin="0,0,8,0" />
        <TextBox Grid.Column="4" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Window(s)" Margin="0,0,8,0" />
        <TextBox Grid.Column="7" Text="{Binding WindowSeconds, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Column="9" VerticalAlignment="Center" Text="Status" Margin="0,0,8,0" />
        <TextBlock Grid.Column="10" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionStatusBrush}" />

        <StackPanel Grid.Column="12" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Command="{Binding StartCommand}" Content="Start" IsEnabled="{Binding CanStart}" />
          <Button Command="{Binding StopCommand}" Content="Stop" Margin="8,0,0,0" IsEnabled="{Binding CanStop}" />
        </StackPanel>

        <CheckBox Grid.Column="14" VerticalAlignment="Center" Content="Pause Auto Scroll" Foreground="#D4EDFF" IsChecked="{Binding IsAutoScrollPaused}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="#203846" BorderThickness="1" Background="#070D11" Padding="6" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Throttle / Brake Overlay" FontWeight="SemiBold" Margin="4,0,0,6" />
          <lvc:CartesianChart Grid.Row="1" Series="{Binding ThrottleBrakeSeries}" XAxes="{Binding SharedTimeAxis}" YAxes="{Binding InputAxis}" DrawMarginFrame="False" />
        </Grid>
      </Border>

      <Border Grid.Row="1" BorderBrush="#203846" BorderThickness="1" Background="#070D11" Padding="6" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Speed" FontWeight="SemiBold" Margin="4,0,0,6" />
          <lvc:CartesianChart Grid.Row="1" Series="{Binding SpeedSeries}" XAxes="{Binding SharedTimeAxis}" YAxes="{Binding SpeedAxis}" DrawMarginFrame="False" />
        </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="#203846" BorderThickness="1" Background="#070D11" Padding="6" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Gear / RPM" FontWeight="SemiBold" Margin="4,0,0,6" />
          <lvc:CartesianChart Grid.Row="1" Series="{Binding GearRpmSeries}" XAxes="{Binding SharedTimeAxis}" YAxes="{Binding GearRpmAxes}" DrawMarginFrame="False" />
        </Grid>
      </Border>

      <Border Grid.Row="3" BorderBrush="#203846" BorderThickness="1" Background="#070D11" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Lap Delta (vs Baseline Lap)" FontWeight="SemiBold" Margin="4,0,0,6" />
          <lvc:CartesianChart Grid.Row="1" Series="{Binding DeltaSeries}" XAxes="{Binding SharedTimeAxis}" YAxes="{Binding DeltaAxis}" DrawMarginFrame="False" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
