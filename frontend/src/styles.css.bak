@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap');

:root {
  color-scheme: dark;
  --bg: #040506;
  --panel: #080d10;
  --panel-soft: #0d1419;
  --edge: #1f313b;
  --edge-strong: #32515f;
  --text: #d4edff;
  --muted: #7fa0b5;
  --accent: #00b3ff;
  --alert: #ffc400;
  --critical: #ff4949;
  --ok: #2cf98e;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(1200px 620px at 8% 12%, rgba(0, 168, 255, 0.2), transparent 62%),
    radial-gradient(900px 500px at 92% 88%, rgba(255, 145, 0, 0.12), transparent 58%),
    linear-gradient(120deg, #030506 0%, #04080a 52%, #020304 100%);
  font-family: 'Rajdhani', 'Segoe UI', sans-serif;
}

.app-shell {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  padding: 10px;
  display: grid;
  gap: 8px;
  grid-template-rows: auto 1fr;
}

.background-grid {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.22;
  background-image:
    linear-gradient(rgba(0, 155, 255, 0.14) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 155, 255, 0.14) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: linear-gradient(to bottom, black 0%, black 74%, transparent 100%);
}

.top-zone {
  display: block;
}

.quick-toggle-row {
  margin-top: 8px;
  display: flex;
  justify-content: flex-end;
}

.toggle-btn {
  border: 1px solid var(--edge-strong);
  background: linear-gradient(180deg, #13212b, #0c151c);
  color: #dbf0ff;
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 6px 10px;
  cursor: pointer;
}

.toggle-btn:hover {
  border-color: #7abbe6;
}

.app-shell.hide-rail .utility-rail {
  display: none;
}

.app-shell.hide-rail .command-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.command-grid {
  display: grid;
  grid-template-columns: 0.62fr 1.06fr 0.98fr 1.06fr;
  gap: 8px;
  min-height: 0;
}

.zone {
  display: grid;
  gap: 8px;
  min-height: 0;
  align-content: start;
}

.utility-rail {
  display: grid;
  gap: 6px;
  align-content: start;
}

.telemetry-frame,
.panel {
  position: relative;
  border: 1px solid var(--edge);
  background:
    linear-gradient(180deg, rgba(36, 73, 98, 0.17) 0%, rgba(16, 22, 27, 0.55) 8%, transparent 100%),
    linear-gradient(180deg, #090e11 0%, #070a0d 100%);
  box-shadow:
    inset 0 0 0 1px rgba(123, 203, 255, 0.05),
    0 0 0 1px rgba(0, 0, 0, 0.35),
    0 8px 20px rgba(0, 0, 0, 0.35);
  padding: 8px;
}

.panel::before,
.telemetry-frame::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  border: 1px solid rgba(113, 170, 203, 0.08);
}

.panel h3,
.telemetry-frame h3 {
  margin: 0;
  text-transform: uppercase;
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.14em;
  color: var(--muted);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}

.kpi {
  border: 1px solid var(--edge);
  background: linear-gradient(180deg, rgba(23, 35, 43, 0.8), rgba(9, 14, 18, 0.7));
  padding: 6px;
}

.label {
  color: var(--muted);
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.value {
  font-family: 'Space Mono', monospace;
  font-weight: 700;
  font-size: 14px;
  color: #eef8ff;
}

.small {
  color: var(--muted);
  font-size: 11px;
  font-family: 'Space Mono', monospace;
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.table th,
.table td {
  border-bottom: 1px solid #16232d;
  padding: 4px 3px;
  text-align: left;
  font-family: 'Space Mono', monospace;
}

.table th {
  color: #91b6cf;
  font-weight: 400;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.04em;
}

.bar {
  height: 12px;
  border: 1px solid #2a404e;
  background: linear-gradient(180deg, #070b0e, #090f13);
}

.bar > span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #0a597d, var(--accent));
  box-shadow: 0 0 10px rgba(0, 179, 255, 0.32);
}

.health-dot {
  width: 10px;
  height: 10px;
  display: inline-block;
  border-radius: 1px;
  margin-right: 6px;
}

.footer-note {
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
  font-family: 'Space Mono', monospace;
}

.badge-raw,
.badge-est {
  display: inline-block;
  border: 1px solid var(--edge);
  padding: 1px 5px;
  font-size: 10px;
  margin-left: 6px;
  font-family: 'Space Mono', monospace;
  letter-spacing: 0.05em;
}

.badge-raw {
  color: var(--ok);
}

.badge-est {
  color: var(--alert);
}

.confidence-pill {
  border: 1px solid var(--edge-strong);
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  padding: 3px 8px;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.confidence-pill.is-high {
  color: var(--ok);
  border-color: #2e6f49;
}

.confidence-pill.is-medium {
  color: var(--alert);
  border-color: #7d6930;
}

.confidence-pill.is-low {
  color: var(--critical);
  border-color: #783636;
}

.strategy-inputs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.chip {
  border: 1px solid var(--edge);
  background: var(--panel-soft);
  padding: 3px 7px;
  font-size: 10px;
  font-family: 'Space Mono', monospace;
  letter-spacing: 0.02em;
}

.reason-list {
  display: grid;
  gap: 4px;
}

.reason-line {
  font-size: 11px;
  line-height: 1.35;
  font-family: 'Space Mono', monospace;
  border-left: 2px solid #2f4f5e;
  padding-left: 6px;
}

.candidate-best {
  background: rgba(44, 249, 142, 0.07);
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(11, minmax(0, 1fr));
  gap: 8px;
}

.status-cell {
  border: 1px solid var(--edge);
  background: rgba(8, 15, 20, 0.8);
  padding: 6px;
  min-height: 54px;
}

@media (max-width: 1440px) {
  .command-grid {
    grid-template-columns: 1fr 1fr;
  }

  .utility-rail {
    grid-column: span 2;
  }
}

@media (max-width: 1080px) {
  .status-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .command-grid {
    grid-template-columns: 1fr;
  }

  .utility-rail {
    grid-column: auto;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .quick-toggle-row {
    justify-content: stretch;
  }

  .toggle-btn {
    width: 100%;
  }

  .app-shell.hide-rail .command-grid {
    grid-template-columns: 1fr;
  }
}
