PORT=8080
HOST=0.0.0.0
BRIDGE_TOKENS=replace-with-long-random-token
MAX_STATE_AGE_MS=12000
STREAM_HZ=15
MAX_SESSION_IDLE_MS=1800000
CORS_ORIGIN=*
DEFAULT_SESSION_ID=public
MODEL_PATH=./data/strategy-model.json
FEEDBACK_LOG_PATH=./data/strategy-feedback.ndjson

# Multiplayer room auth
ROOM_AUTH_SECRET=replace-with-long-random-secret
