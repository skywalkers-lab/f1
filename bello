#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"
LOG_DIR="$ROOT_DIR/.bello"

mkdir -p "$LOG_DIR"

backend_log="$LOG_DIR/backend.log"
frontend_log="$LOG_DIR/frontend.log"

backend_port=8765
frontend_port=5173

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

is_listening() {
  local port="$1"
  lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
}

ensure_backend_ready() {
  if [ ! -d "$BACKEND_DIR/.venv" ]; then
    printf 'Creating backend virtual environment...\n'
    python3 -m venv "$BACKEND_DIR/.venv"
  fi

  if [ ! -x "$BACKEND_DIR/.venv/bin/uvicorn" ]; then
    printf 'Installing backend dependencies...\n'
    "$BACKEND_DIR/.venv/bin/pip" install -e "$BACKEND_DIR[dev]"
  fi
}

ensure_frontend_ready() {
  if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
    printf 'Installing frontend dependencies...\n'
    (cd "$FRONTEND_DIR" && npm install)
  fi
}

start_backend() {
  if is_listening "$backend_port"; then
    printf 'Backend already running on http://127.0.0.1:%s\n' "$backend_port"
    return
  fi

  printf 'Starting backend...\n'
  nohup bash -lc "cd '$BACKEND_DIR' && source .venv/bin/activate && exec uvicorn pitwall.main:app --host 127.0.0.1 --port $backend_port --reload" \
    >"$backend_log" 2>&1 &
}

start_frontend() {
  if is_listening "$frontend_port"; then
    printf 'Frontend already running on http://127.0.0.1:%s\n' "$frontend_port"
    return
  fi

  printf 'Starting frontend...\n'
  nohup bash -lc "cd '$FRONTEND_DIR' && exec npm run dev -- --host 127.0.0.1 --port $frontend_port" \
    >"$frontend_log" 2>&1 &
}

require_command python3
require_command npm
require_command lsof

ensure_backend_ready
ensure_frontend_ready
start_backend
start_frontend

printf '\nServices\n'
printf '  Backend : http://127.0.0.1:%s\n' "$backend_port"
printf '  Frontend: http://127.0.0.1:%s\n' "$frontend_port"
printf '\nLogs\n'
printf '  %s\n' "$backend_log"
printf '  %s\n' "$frontend_log"